# App data
allow vendor_dataservice_app radio_data_file:dir { getattr search };

# Properties
set_prop(vendor_dataservice_app, lge_ims_wo_prop)
set_prop(vendor_dataservice_app, lge_ims_data_prop)
set_prop(vendor_dataservice_app, lge_ims_sar_ratpreference_prop)
set_prop(vendor_dataservice_app, lge_ims_iwlan_possible_prop)
set_prop(vendor_dataservice_app, lge_wo_apntypes_prop)
set_prop(vendor_dataservice_app, lge_iwlan_hosupport_prop)
set_prop(vendor_dataservice_app, lge_iwlan_hosupport_roam_prop)
set_prop(vendor_dataservice_app, lge_ims_calltype_prop)

get_prop(vendor_dataservice_app, lge_ims_data_prop)
get_prop(vendor_dataservice_app, lge_ims_iwlan_possible_prop)
get_prop(vendor_dataservice_app, lge_ims_wo_prop)
get_prop(vendor_dataservice_app, vendor_lge_misc_prop)

allow vendor_dataservice_app system_data_file:dir { getattr search };
allow vendor_dataservice_app ims_service:service_manager find;

#Ipsecd
allow vendor_dataservice_app ipsecd_socket:unix_stream_socket connectto;
allow vendor_dataservice_app ipsecd_socket:sock_file write;
allow vendor_dataservice_app wifi_hal_prop:file { getattr map open read };

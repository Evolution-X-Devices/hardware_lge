type lge_dataservice_app, domain, appdomain;
app_domain(lge_dataservice_app)
net_domain(lge_dataservice_app)
typeattribute lge_dataservice_app mlstrustedsubject;


hwbinder_use(lge_dataservice_app)

# App data
allow lge_dataservice_app radio_data_file:dir { getattr search create_dir_perms };
allow lge_dataservice_app radio_data_file:file create_file_perms;
allow lge_dataservice_app radio_data_file:lnk_file r_file_perms;

# System services 
allow lge_dataservice_app app_api_service:service_manager find;

# HAL
hal_client_domain(lge_dataservice_app, hal_lgdata)
allow lge_dataservice_app hal_lgdata_hwservice:hwservice_manager find;

# Properties
set_prop(lge_dataservice_app, lge_ims_wo_prop)
set_prop(lge_dataservice_app, lge_ims_data_prop)
set_prop(lge_dataservice_app, lge_ims_sar_ratpreference_prop)
set_prop(lge_dataservice_app, lge_ims_iwlan_possible_prop)
set_prop(lge_dataservice_app, lge_wo_apntypes_prop)
set_prop(lge_dataservice_app, lge_iwlan_hosupport_prop)
set_prop(lge_dataservice_app, lge_iwlan_hosupport_roam_prop)
set_prop(lge_dataservice_app, lge_ims_calltype_prop)

get_prop(lge_dataservice_app, lge_ims_data_prop)
get_prop(lge_dataservice_app, lge_ims_iwlan_possible_prop)
get_prop(lge_dataservice_app, lge_ims_wo_prop)
get_prop(lge_dataservice_app, vendor_lge_misc_prop)



allow lge_dataservice_app system_data_file:dir { getattr search };
allow lge_dataservice_app ims_service:service_manager find;
allow lge_dataservice_app hal_lge_vssims_hwservice:hwservice_manager find;
binder_call(lge_dataservice_app, hal_vssims_default)
allow lge_dataservice_app activity_service:service_manager find;


allow lge_dataservice_app gpu_service:service_manager find;
allow lge_dataservice_app netstats_service:service_manager find;
allow lge_dataservice_app radio_service:service_manager find;
allow lge_dataservice_app registry_service:service_manager find;
allow lge_dataservice_app thermal_service:service_manager find;
allow lge_dataservice_app statusbar_service:service_manager find;
allow lge_dataservice_app cameraserver_service:service_manager find;
allow lge_dataservice_app hal_lgdata_hwservice:hwservice_manager find;



#Ipsecd

allow lge_dataservice_app ipsecd_socket:unix_stream_socket connectto;
allow lge_dataservice_app ipsecd_socket:sock_file write;
allow lge_dataservice_app wifi_hal_prop:file { getattr map open read };

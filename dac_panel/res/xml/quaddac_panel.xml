<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    android:title="@strings/quad_dac">

    <SwitchPreference
        app:key="quaddac_switch"
        app:summaryOn="@string/quad_dac_on"
        app:summaryOff="@string/quad_dac_off"
        app:title="@string/quad_dac"
        app:isPreferenceVisible="false" />

    <PreferenceCategory
        app:title="@string/quad_dac_settings" >

        <ListPreference
            app:key="hifi_mode_dropdown"
            app:title="@string/hifi_mode"
            app:summary="%s"
            app:entries="@array/hifi_mode_entry_values"
            app:entryValues="@array/hifi_mode_entry_values"
            app:isPreferenceVisible="false" />

        <SeekBarPreference
            app:key="avc_volume_seekbar"
            app:title="@string/avc_volume"
            app:summary="@string/avc_volume_summary"
            app:showSeekBarValue="true"
            app:min="-24"
            android:max="0"
            app:defaultValue="-14"
            app:isPreferenceVisible="false" />

        <ListPreference
            app:key="sound_preset_dropdown"
            app:title="@string/sound_preset"
            app:summary="%s"
            app:entries="@array/sound_preset_entry_values"
            app:entryValues="@array/sound_preset_entry_values"
            app:isPreferenceVisible="false" />

        <ListPreference
            app:key="digital_filter_dropdown"
            app:title="@string/digital_filter"
            app:summary="%s"
            app:entries="@array/digital_filter_entry_values"
            app:entryValues="@array/digital_filter_entry_values"
            app:isPreferenceVisible="false" />

        <SwitchPreference
            app:key="bit_perfect_switch"
            app:title="@string/bit_perfect"
            app:summary="@string/bit_perfect_summary"
            app:isPreferenceVisible="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/eq_category_title">

        <SwitchPreference
            app:key="eq_switch"
            app:title="@string/eq_enable"
            app:summary="@string/eq_enable_summary"
            app:isPreferenceVisible="false" />

        <ListPreference
            app:key="eq_preset_dropdown"
            app:title="@string/eq_preset"
            app:summary="%s"
            app:entries="@array/eq_preset_entries"
            app:entryValues="@array/eq_preset_entries"
            app:isPreferenceVisible="false" />

        <Preference
            app:key="eq_load_preset"
            app:title="@string/eq_load_preset"
            app:summary="@string/eq_load_preset_summary"
            app:isPreferenceVisible="false" />

        <Preference
            app:key="eq_save_preset"
            app:title="@string/eq_save_preset"
            app:summary="@string/eq_save_preset_summary"
            app:isPreferenceVisible="false" />

        <Preference
            app:key="eq_reset"
            app:title="@string/eq_reset"
            app:summary="@string/eq_reset_summary"
            app:isPreferenceVisible="false" />

        <SeekBarPreference
            app:key="eq_band0"
            app:title="@string/eq_band_31"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band1"
            app:title="@string/eq_band_62"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band2"
            app:title="@string/eq_band_125"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band3"
            app:title="@string/eq_band_250"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band4"
            app:title="@string/eq_band_500"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band5"
            app:title="@string/eq_band_1k"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band6"
            app:title="@string/eq_band_2k"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band7"
            app:title="@string/eq_band_4k"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band8"
            app:title="@string/eq_band_8k"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />
        <SeekBarPreference
            app:key="eq_band9"
            app:title="@string/eq_band_16k"
            app:min="-12"
            android:max="12"
            app:defaultValue="0"
            app:isPreferenceVisible="false" />

    </PreferenceCategory>

    <!-- Customizable filter category -->
    <PreferenceCategory
        app:title="@string/customizable_filter_settings">

        <ListPreference
            app:key="custom_filter_shape"
            app:title="@string/cf_shape"
            app:summary="%s"
            app:entries="@array/custom_filter_shapes"
            app:entryValues="@array/custom_filter_shapes" />

        <ListPreference
            app:key="custom_filter_symmetry"
            app:title="@string/cf_symmetry"
            app:summary="%s"
            app:entries="@array/custom_filter_symmetries"
            app:entryValues="@array/custom_filter_symmetries" />

    </PreferenceCategory>

    <!-- These ones really need their own category to keep things more organized -->
    <PreferenceCategory
        app:title="@string/customizable_filter_coeffs"
        app:summary="@string/customizable_filter_coeffs_summary">

        <!-- Tons of coefficient seekbars BEGIN -->
        <SeekBarPreference
            app:key="custom_filter_coeff0"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff1"
            app:title=""

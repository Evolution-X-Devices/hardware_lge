        <SeekBarPreference
            app:key="custom_filter_coeff7"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff8"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff9"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff10"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff11"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff12"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff13"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />

        <!-- Tons of coefficient seekbars END -->

        <org.lineageos.settings.device.dac.ui.ButtonPreference
            android:key="reset_coefficients"
            android:summary=""
            android:title="" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/quad_dac_balance" >

        <org.lineageos.settings.device.dac.ui.BalancePreference
            app:key="balance"
            app:summary="@string/quad_dac_balance_summary"
            app:title=""
            app:isPreferenceVisible="false" />

    </PreferenceCategory>

</PreferenceScreen>

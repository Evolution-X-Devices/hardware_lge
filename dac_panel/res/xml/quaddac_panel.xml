            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff4"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
            android:max="9999999"
            app:defaultValue="0" />
        <SeekBarPreference
            app:key="custom_filter_coeff5"
            app:title=""
            app:summary="%s"
            app:min="-9999999"
